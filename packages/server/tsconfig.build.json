  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "Bundler",
    "rootDir": "sources",
    "outDir": "exports/types"
  },
  "include": ["sources/**/*.ts"],
  "exclude": ["sources/**/*.test.ts"]
}
